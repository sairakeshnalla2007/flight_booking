# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Runtime Variables (injected automatically by AI Studio)
SQL_HOST="MY_SQL_HOST"
SQL_DB_NAME="MY_SQL_DB_NAME"
SQL_USER="MY_SQL_USER"
SQL_PASSWORD="MY_SQL_PASSWORD"

# Cloud SQL PostgreSQL Admin Variables (used by Drizzle Kit schema push)
SQL_ADMIN_USER="MY_SQL_ADMIN_USER"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"
